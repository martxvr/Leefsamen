{% schema %}
{
    "name": "Pakketten",
    "settings": [
        {
            "type": "text",
            "id": "example_text",
            "label": "Example Text",
            "default": "Default Value"
        }
    ],
    "blocks": [
        {
            "type": "pakket",
            "name": "Pakket",
            "settings": [
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title",
                    "default": "Pakket Title"
                },
                {
                    "type": "textarea",
                    "id": "description",
                    "label": "Description",
                    "default": "Pakket Description"
                },
                {
                    "type": "text",
                    "id": "price",
                    "label": "Price",
                    "default": "€9,95"
                },
                {
                    "type": "checkbox",
                    "id": "most_chosen",
                    "label": "Most Chosen",
                    "default": false
                },
                {
                    "type": "textarea",
                    "id": "features",
                    "label": "Features",
                    "default": "Feature 1\nFeature 2\nFeature 3"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Default",
            "category": "Custom",
            "blocks": [
                {
                    "type": "pakket"
                },
                {
                    "type": "pakket"
                },
                {
                    "type": "pakket"
                }
            ]
        }
    ]
}
{% endschema %}

<section class="bg-white py-20">
    <div class="container mx-auto text-center px-4 md:px-0 max-w-[900px]">
        <h2 class="text-4xl font-bold mb-4 font-ubuntu">Onze Pakketten</h2>
        <p class="text-xl mb-10 font-ubuntu">Kies het pakket dat het beste bij je past</p>
        <div class="flex flex-col lg:flex-row justify-center items-center lg:space-x-10 space-y-10 lg:space-y-0">
            {% for block in section.blocks %}
            <div class="{% if block.settings.most_chosen %}relative bg-[#0E2756] text-white{% else %}bg-[#E1E1FA] text-[#0E2756]{% endif %} w-full max-w-[438px] p-8 rounded-[16px] flex flex-col min-h-[375px] h-full">
                {% include 'most_chosen', most_chosen: block.settings.most_chosen %}
                <div class="mb-8">
                    <h3 class="text-3xl font-bold text-left font-ubuntu mt-4 mb-4">{{ block.settings.title }}</h3>
                    <p class="text-lg text-left font-ubuntu">{{ block.settings.description }}</p>
                </div>
                <p class="text-4xl font-bold mb-4 text-left font-ubuntu">{{ block.settings.price }} <span class="text-lg font-normal">per maand</span></p>
                <button class="bg-[#FF9855] text-[#0E2756] py-2 w-full rounded-full mb-6 font-bold font-ubuntu">Bekijk pakket</button>
                {% include 'features', features: block.settings.features, most_chosen: block.settings.most_chosen %}
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{% javascript %}
{% endjavascript %}