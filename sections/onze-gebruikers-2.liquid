{% schema %}
{
  "name": "Onze gebruikers 2.0",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Dit zeggen onze gebruikers"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "city",
          "label": "City"
        },
        {
          "type": "text",
          "id": "person",
          "label": "Person"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Onze gebruikers 2.0",
      "category": "Text"
    }
  ]
}
{% endschema %}

{%  stylesheet %}

section.onze-gebruikers-2 {
  font-family: Aller, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  height: auto;
  margin: 0;
  background-color: #efefef;
}

/* Grijze container */
.testimonial-container {
  position: relative;
  width: 1200px;
  height: auto;
  background-color: #efefef;
  display: flex;
  flex-direction: column;
  justify-content: top;
  align-items: center;
  border-radius: 40px;
  padding: 20px;
  box-sizing: border-box;
}

.swiper {
  width: 1045px;
  height: auto;
}

.swiper-slide {
  background-color: #fff;
  border-radius: 20px;
  padding: 20px;
  display: flex;
  flex-direction: row;
  box-sizing: border-box;
  gap: 40px;
  width: 47%;
  height: 300px;
}

.swiper-pagination {
  display: none;
  position: absolute;
  bottom: 30px !important;
}

.swiper-button-next {
  position: absolute;
  right: 30px !important;
  color: #000;
}

.swiper-button-prev {
  position: absolute;
  left: 30px !important;
  color: #000;
}

.swiper-wrapper {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 50px;
  justify-content: space-between;
}

.s-cta-box {
  margin-bottom: 25px;
}

.swiper-slide-content > p:first-of-type {
  line-height: 1.5;
}

@media screen and (max-width: 1000px) {
  section.onze-gebruikers-2 {
    height: auto !important;
  }

  .testimonial-container {
    width: 100% !important;
    height: auto !important;
    border-radius: 0px !important;
  }

  .testimonial-container h1 {
    font-size: 30px !important;
    margin-left: 0px !important;
    margin-right: 0px !important;
    text-align: left;
    margin-bottom: 20px !important;
  }

  .swiper {
    width: 100% !important;
    height: auto !important;
  }

  .swiper-slide {
    width: 100% !important;
    height: auto !important;
    flex-direction: column !important;
    align-items: center !important;
  }

  .s-cta-box {
    flex-direction: column !important;
    margin: 20px auto !important;
    width: 100% !important;
  }

  .swiper-wrapper {
    margin-bottom: 0px;
  }
}

{%  endstylesheet %}

<section class="onze-gebruikers-2">
  <div class="testimonial-container">
    <h1 style="margin-right: auto; margin-left: 55px; font-size: 45px; font-weight: bold; margin-bottom: 50px;">{{ section.settings.heading }}</h1>
    <!-- Swiper -->
    <div class="swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide">
            <img src="{{ block.settings.image | img_url: 'master' }}" alt="" width="197px" height="262px" style="border-radius: 20px; object-fit: cover;">
            <div class="swiper-slide-content">
              <div class="gemeente-box" style="display: flex; flex-direction: row; gap: 15px;">
                <img src="{{ block.settings.logo | img_url: 'master' }}" alt="" width="64px" height="64px" style="border-radius: 100%; border: 1px solid lightgray;">
                <div class="gemeente-box-text" style="display: flex; flex-direction: column;">
                  <p style="font-style: light; margin: 0; font-size: 12px; height: 12px !important;">Gemeente</p>
                  <p style="font-weight: bold; margin: 0; font-size: 18px; height: 25px !important;">{{ block.settings.city }}</p>
                  <p style="margin: 0; font-size: 12px;">{{ block.settings.person }}</p>
                </div>
              </div>
              <p style="font-weight: bold; font-size: 18px; margin-top: 20px;">{{ block.settings.title }}</p>
              <p style="font-style: italic; font-size: 12px;">{{ block.settings.quote }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="s-cta-box" style="display: flex; flex-direction: row; gap: 20px; margin-right: auto; margin-left: 55px; margin-top: 50px;">
      <a href="pages/probeer-het-uit" style="padding: 20px; text-align: center; background-color: #D9D9D9; border-radius: 12px; font-weight: bold; color: #000; text-decoration: none;">Brochure aanvragen</a>
      <a href="/pages/alarmeringen" style="padding: 20px; text-align: center; background-color: #FF6F00; border-radius: 12px; font-weight: bold; color: #fff; text-decoration: none;">Direct aanmelden</a>
    </div>
  </div>
</section>

{% javascript %}

{% endjavascript %}

