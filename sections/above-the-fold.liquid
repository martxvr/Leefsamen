{% schema %}
{
  "name": "Above The Fold",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Snel hulp bij iedere noodsituatie in huis"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description",
      "default": "Binnen een paar seconden krijgen familie, buren of bekenden een alarm en komen helpen. Wel zo’n gerust gevoel."
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "default": "Probeer het uit!"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "image_description",
      "label": "Image Description",
      "default": "Veiligheid 24/7 gemonitord door de unieke combinatie van slimme sensoren, een app en alarmknop."
    }
  ],
  "blocks": [
    {
      "type": "list_item",
      "name": "List Item",
      "settings": [
        {
          "type": "text",
          "id": "item_text",
          "label": "Item Text",
          "default": "Alarm bij val, inbraak, brand & noodsituaties thuis en onderweg."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Above The Fold",
      "category": "Text"
    }
  ]
}
{% endschema %}

{%  stylesheet %}
.above-the-fold {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px; 
    background-color: #fff;
    max-width: 1200px;
    justify-content: center;
    margin: 0 auto;
    margin-bottom: 60px;
}

  @media screen and (max-width: 1000px) {
    .above-the-fold {
      margin-bottom: 0px;
    }
  }

.heading-p h1 {
    font-size: 45px;
    font-weight: bold;
    margin-bottom: 20px;
}

.atf-container-2 h4 {
    font-size: 24px;
    font-weight: 600;
    margin: 0px;
}

.atf-container-2 ul li {
    list-style-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23000000"><path d="M9 19c-.26 0-.51-.1-.71-.29l-6-6A.996.996 0 1 1 3.7 11.3l5.29 5.29L20.28 5.3a.996.996 0 1 1 1.41 1.41l-12 12c-.2.2-.45.29-.71.29Z"></path></svg>');
}

.atf-container-2 ul li::marker {
    font-size: 2.0em;
}

.atf-container-2 ul {
  padding: 0px;
}
.atf-container {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: 80px;
}

.atf-container-1 {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 50%;
}

.atf-container-1 img {
      border-radius: 8px;
    }

.atf-container-2 {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 50%;
}

  @media screen and (max-width: 1000px) {
    .atf-container {
        flex-direction: column;
    }

    .atf-container-1 {
        width: 100% !important;
        gap: 10px;
    }

    .atf-container-1 img {
      width: 100%;
      height: auto;
    }

    .atf-container-2 {
        width: 100%;
        gap: 0px;
    }

    .atf-container-2 ul {
        padding: 20px !important;
        margin: 0px;
    }

    .heading-p h1 {
      font-size: 32px;
    }

    .above-cta-box {
      flex-direction: column !important;
    }
 }
  {%  endstylesheet %}

<section class="above-the-fold">
    <p class="scroll-trigger animate--slide-in" style="color: #000;"> <span style="font-style: italic;">"{{ section.settings.quote }}"</span> - <strong>Anja Gerards 74 jaar</strong></p>
    <div class="heading-p scroll-trigger animate--slide-in">
      <h1>{{ section.settings.title }}</h1>
      <p style="color: #000;">{{ section.settings.text }}</p>
    </div>
    <div class="atf-container">
      <div class="atf-container-1 scroll-trigger animate--slide-in">
        <img src="{{ section.settings.image | image_url }}" alt="" width="100%" height="auto">
        <p style="color: grey; font-style: italic;">{{ section.settings.image_description }}</p>
      </div>
      <div class="atf-container-2 scroll-trigger animate--slide-in">
        <h4>De meest complete én betaalbare alarmering die super snel werkt.</h4>
        <ul>
          {% for block in section.blocks %}
            <li>{{ block.settings.item_text }}</li>
          {% endfor %}
        </ul>
       <div class="above-cta-box" style="display:flex;flex-direction:row;gap:20px;justify-content:space-between:">
          <a href="/pages/alarmeringen" style="display: block;padding:20px;background-color:#e96411;border-radius:12px;width:100%;text-align:center;">Naar alarm thuis</a>
        <a href="/pages/mobiele-knop" style="display: block;padding:20px;background-color:#e96411;border-radius:12px;width:100%;text-align:center;">Naar alarm onderweg</a>
       </div>
      </div>
    </div>
   </section>